# Optional HTTPS backend for address search. No request is sent when unset.
EXPO_PUBLIC_API_URL=

# Restricted public Android SDK key; embedded only at native build time.
# Restrict to Maps SDK for Android, package com.yallanrouh.demo and signing SHA-1.
GOOGLE_MAPS_ANDROID_API_KEY=

# Optional protected project backend for Google Routes. Not a Google API key.
# No Routes API requests occur when unset. Never embed a Routes server key.
EXPO_PUBLIC_GOOGLE_ROUTES_PROXY=

# Separate public Maps JavaScript API key, restricted to the website referrers.
# GitHub Pages uses repository secret GOOGLE_MAPS_WEB_API_KEY. Never reuse the Android or Routes key.
EXPO_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_WEB_MAP_ID=
