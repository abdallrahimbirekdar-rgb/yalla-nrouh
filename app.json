{
  "expo": {
    "name": "يلا نروح",
    "slug": "yalla-nrouh",
    "version": "1.1.9",
    "orientation": "portrait",
    "icon": "./assets/app-icon-approved.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/logo-approved.png",
      "resizeMode": "contain",
      "backgroundColor": "#edf3fb"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yallanrouh.demo"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#edf3fb",
        "foregroundImage": "./assets/adaptive-approved.png",
        "monochromeImage": "./assets/monochrome-approved.png"
      },
      "package": "com.yallanrouh.demo",
      "versionCode": 38,
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.READ_SMS",
        "android.permission.RECEIVE_SMS",
        "android.permission.SEND_SMS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon-approved.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      "expo-system-ui",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": true,
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ]
          }
        }
      ]
    ],
    "scheme": "yallanrouh",
    "backgroundColor": "#edf3fb"
  }
}
