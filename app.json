{
  "expo": {
    "name": "يلا نروح",
    "slug": "yalla-nrouh",
    "version": "0.4.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon-approved.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo-approved.png",
      "resizeMode": "contain",
      "backgroundColor": "#fffaf5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yallanrouh.demo"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#fffaf5",
        "foregroundImage": "./assets/adaptive-approved.png",
        "monochromeImage": "./assets/monochrome-approved.png"
      },
      "package": "com.yallanrouh.demo",
      "versionCode": 4
    },
    "web": {
      "favicon": "./assets/favicon-approved.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      "expo-system-ui"
    ],
    "scheme": "yallanrouh",
    "backgroundColor": "#ffffff"
  }
}
