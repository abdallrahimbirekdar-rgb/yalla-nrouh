{
  "expo": {
    "name": "يلا نروح",
    "slug": "yalla-nrouh",
    "version": "0.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0e1b"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yallanrouh.demo"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#19162e",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.yallanrouh.demo",
      "versionCode": 3
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      "expo-system-ui"
    ],
    "scheme": "yallanrouh",
    "backgroundColor": "#0b0e1b"
  }
}
